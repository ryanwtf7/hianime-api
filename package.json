{
  "name": "hianime-v2",
  "version": "2.3.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanwtf7/hianime-api.git"
  },
  "bugs": {
    "url": "https://github.com/ryanwtf7/hianime-api/issues"
  },
  "homepage": "https://github.com/ryanwtf7/hianime-api#readme",
  "scripts": {
    "dev": "bun run --hot index.ts",
    "start": "bun index.ts",
    "build": "bun build index.ts --outdir ./dist --target bun",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.cache",
    "vercel-build": "ncc build api/index.ts -o api"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vercel/ncc": "^0.45.0",
    "bun-types": "^1.4.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
